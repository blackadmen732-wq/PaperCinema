node_modules/
output/
gpu/.pod.json
assets/sfx/_cand.*
__pycache__/
assets/polyhaven/*
!assets/polyhaven/CREDITS.md

# graphify knowledge graph: rebuilt locally in ~8 s by `graphify update .`,
# and graph.json is rewritten whole on every change, so it is not worth 11 MB
# of repo churn. The .graphifyignore rules ARE committed, so every machine
# builds the same graph.
graphify-out/

# Outside tools: fetched by `node tools/vendor.mjs` at the commits vendor/MANIFEST.json pins.
# The manifest is the contract and IS committed; the checkouts are a cache and are not.
vendor/*/
