    "sound": "node engine/sound.mjs",
    "playbook": "python3 docs/build_playbook.py",
    "film": "node engine/make.mjs",
    "preview": "node engine/serve.mjs"
  },
  "dependencies": {
    "three": "0.170.0"
  }
}