{
  "name": "paper-cinema",
  "version": "0.1.0",
  "private": true,
  "description": "Paper-craft cinematic animation system: shot list -> 3D paper world -> MP4",
  "type": "module",
  "scripts": {
    "check": "node engine/validate.mjs && node engine/render.mjs --still auto",
    "validate": "node engine/validate.mjs",
    "still": "node engine/render.mjs --still",
    "render": "node engine/render.mjs",
    "sound": "node engine/sound.mjs",
    "playbook": "python3 docs/build_playbook.py",
    "film": "bash tools/film.sh",
    "preview": "node engine/serve.mjs",
    "shimi": "python3 engine/shimi.py --preset kesa-cut --out output/shimi/kesa-cut",
    "systems": "python3 tools/build_systems.py",
    "ae": "python3 packages/aethern/bin/aethern",
    "new-film": "node engine/new-film.mjs",
    "vendor": "node tools/vendor.mjs",
    "promises": "node tools/promises.mjs",
    "storyboard": "node engine/render.mjs   # FAST box preview, not the film"
  },
  "dependencies": {
    "three": "0.170.0"
  }
}
