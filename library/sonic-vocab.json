      "need": {
        "action": "whoosh"
      },
      "prefer": {
        "material": "air"
      },
      "targets": {
        "intensity": {
          "from": "speed",
          "in": [
            9,
            30
          ],
          "out": [
            0.25,
            0.85
          ],
          "w": 1.0
        },
        "brightness": {
          "from": "speed",
          "in": [
            9,
            30
          ],
          "out": [
            0.35,
            0.8
          ],
          "w": 0.6
        }
      },
      "maxDur": 1.2,
      "align": "peak",
      "variety": 3,
      "words": [],
      "avoid": {
        "material": ["synthetic"],
        "action": ["ui"]
      }
    },
